# OpenAI-совместимый эндпоинт (Ollama / vLLM / OpenAI).
# Если VITE_LLM_URL пуст — используется встроенный эвристический анализ.
# Ollama:  VITE_LLM_URL=http://localhost:11434/v1   VITE_LLM_MODEL=qwen2.5:7b
# vLLM:    VITE_LLM_URL=http://localhost:8000/v1
# OpenAI:  VITE_LLM_URL=https://api.openai.com/v1   VITE_LLM_MODEL=gpt-4o-mini
VITE_LLM_URL=
# ВНИМАНИЕ: переменные VITE_* попадают в браузер. Не публикуйте сайт с реальным платным ключом.
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini
